# API
APP_NAME=Open Reasoning Engine
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Ollama: qwen2.5:7b-instruct is a balanced default; use a larger model if hardware allows.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_REQUEST_TIMEOUT=180

# Embeddings (runs locally through sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512

# Vector store: qdrant or milvus
VECTOR_STORE=qdrant
COLLECTION_NAME=reasoning_engine
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=

# Retrieval/reasoning
SIMILARITY_TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=100
MAX_RETRIES=1
MIN_RELEVANCE_SCORE=0.25

